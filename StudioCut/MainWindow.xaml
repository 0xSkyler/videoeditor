<Window x:Class="StudioCut.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="StudioCut | Offline Video Editor" Width="1080" Height="900" MinWidth="800" MinHeight="620" Background="#101827" Foreground="#F1F5F9" AllowDrop="True" Drop="OnDrop">
<Window.Resources><Style TargetType="TextBlock"><Setter Property="Margin" Value="0,3,0,3"/></Style><Style TargetType="Button"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="12,7"/><Setter Property="Background" Value="#334155"/><Setter Property="Foreground" Value="White"/></Style><Style TargetType="TextBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="5"/></Style><Style TargetType="ComboBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="5"/></Style><Style TargetType="CheckBox"><Setter Property="Margin" Value="7,4"/><Setter Property="Foreground" Value="#F1F5F9"/></Style></Window.Resources>
<DockPanel Margin="18">
 <StackPanel DockPanel.Dock="Top"><TextBlock Text="STUDIOCUT" FontSize="27" FontWeight="Bold" Foreground="#7DD3FC"/><TextBlock Text="Private, offline editing • Drag a video into this window" Foreground="#94A3B8"/><Separator Margin="0,12"/></StackPanel>
 <StackPanel DockPanel.Dock="Bottom"><Separator Margin="0,10"/><TextBlock x:Name="OutputInfo" Foreground="#A7F3D0" TextWrapping="Wrap" MaxHeight="44"/><TextBlock x:Name="ValidationText" Foreground="#FCA5A5" TextWrapping="Wrap"/><ProgressBar x:Name="Progress" Height="14" Minimum="0" Maximum="100"/><StackPanel Orientation="Horizontal" Margin="0,6"><Button x:Name="ConvertButton" Content="Start Convert" Click="ConvertClick" Background="#0369A1" FontWeight="Bold" IsEnabled="False"/><Button x:Name="CancelButton" Content="Cancel" Click="CancelClick" IsEnabled="False"/><Button x:Name="OpenExportButton" Content="Open exported video" Click="OpenExportClick" IsEnabled="False"/><Button Content="Open folder" Click="OpenFolderClick"/><TextBlock x:Name="Status" VerticalAlignment="Center" Margin="10,0" TextWrapping="Wrap" Text="Select a source video"/></StackPanel></StackPanel>
 <ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Auto"><StackPanel>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#070D17" CornerRadius="10" Padding="8" Height="280"><Grid><MediaElement x:Name="Preview" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" MediaFailed="PreviewFailed" MediaOpened="PreviewOpened" MediaEnded="PreviewEnded"/><Image x:Name="PosterImage" Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False"/></Grid></Border><StackPanel Grid.Column="1" Margin="14,0"><Button x:Name="OpenSourceButton" Content="Open source video" Click="OpenVideoClick"/><Button Content="▶ Play preview" Click="PlayClick"/><Button Content="Ⅱ Pause" Click="PauseClick"/><TextBlock x:Name="VideoInfo" TextWrapping="Wrap" Foreground="#CBD5E1" Margin="8,12"/><TextBlock x:Name="PreviewNote" Text="Preview displays original source (effects are applied only on export)." Foreground="#94A3B8" TextWrapping="Wrap"/></StackPanel></Grid>
  <WrapPanel Margin="0,10,0,0"><TextBlock Text="Playhead" VerticalAlignment="Center"/><Slider x:Name="SeekSlider" Width="440" Minimum="0" Maximum="1" ValueChanged="SeekChanged" Margin="9,0"/><TextBlock x:Name="PlaybackTime" Text="00:00 / 00:00" Width="112" VerticalAlignment="Center"/><Button x:Name="SetStartButton" Content="Set trim start" Click="SetStartFromPreviewClick"/><Button x:Name="SetEndButton" Content="Set trim end" Click="SetEndFromPreviewClick"/></WrapPanel>
  <TextBlock Text="AUDIO" FontSize="20" FontWeight="Bold" Margin="0,18,0,3"/><WrapPanel><TextBlock Text="Mode" VerticalAlignment="Center"/><ComboBox x:Name="AudioMode" Width="175" SelectionChanged="OptionChanged"><ComboBoxItem Content="Keep original"/><ComboBoxItem Content="Mute all"/><ComboBoxItem Content="Replace with music"/><ComboBoxItem Content="Mix music"/></ComboBox><Button Content="Choose music" Click="MusicClick"/><TextBlock x:Name="MusicName" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis"/></WrapPanel>
  <WrapPanel><TextBlock Text="Source audio track" VerticalAlignment="Center"/><ComboBox x:Name="AudioTrack" Width="80" SelectionChanged="OptionChanged"/><TextBlock Text="Volume %" VerticalAlignment="Center"/><TextBox x:Name="Volume" Text="100" Width="55" TextChanged="OptionChanged"/><TextBlock Text="Music %" VerticalAlignment="Center"/><TextBox x:Name="MusicVolume" Text="30" Width="55" TextChanged="OptionChanged"/><TextBlock Text="Music delay (s)" VerticalAlignment="Center"/><TextBox x:Name="MusicOffset" Text="0" Width="58" ToolTip="Positive = start music later; negative = skip its intro" TextChanged="OptionChanged"/><TextBlock Text="Bass dB" VerticalAlignment="Center"/><TextBox x:Name="Bass" Text="0" Width="55" TextChanged="OptionChanged"/><TextBlock Text="Treble dB" VerticalAlignment="Center"/><TextBox x:Name="Treble" Text="0" Width="55" TextChanged="OptionChanged"/></WrapPanel>
  <WrapPanel><CheckBox x:Name="Normalize" Content="Normalize loudness" Checked="OptionChanged" Unchecked="OptionChanged"/><CheckBox x:Name="Denoise" Content="Reduce noise" Checked="OptionChanged" Unchecked="OptionChanged"/><CheckBox x:Name="VoiceEnhance" Content="Voice enhancement" Checked="OptionChanged" Unchecked="OptionChanged"/><CheckBox x:Name="AudioFade" Content="Audio fade in/out" Checked="OptionChanged" Unchecked="OptionChanged"/></WrapPanel>
  <TextBlock Text="VIDEO" FontSize="20" FontWeight="Bold" Margin="0,18,0,3"/><WrapPanel><TextBlock Text="Start (s)" VerticalAlignment="Center"/><TextBox x:Name="TrimStart" Width="75" Text="0" TextChanged="OptionChanged"/><TextBlock Text="End (s; 0 = original)" VerticalAlignment="Center"/><TextBox x:Name="TrimEnd" Width="75" Text="0" TextChanged="OptionChanged"/><TextBlock Text="Width" VerticalAlignment="Center"/><TextBox x:Name="VideoWidth" Width="70" Text="0" TextChanged="OptionChanged"/><TextBlock Text="Height" VerticalAlignment="Center"/><TextBox x:Name="VideoHeight" Width="70" Text="0" TextChanged="OptionChanged"/><TextBlock Text="FPS" VerticalAlignment="Center"/><TextBox x:Name="VideoFps" Width="65" Text="0" TextChanged="OptionChanged"/></WrapPanel>
  <WrapPanel><TextBlock Text="Brightness (-1 to 1)" VerticalAlignment="Center"/><TextBox x:Name="Brightness" Width="65" Text="0" TextChanged="OptionChanged"/><TextBlock Text="Contrast" VerticalAlignment="Center"/><TextBox x:Name="Contrast" Width="65" Text="1" TextChanged="OptionChanged"/><TextBlock Text="Saturation" VerticalAlignment="Center"/><TextBox x:Name="Saturation" Width="65" Text="1" TextChanged="OptionChanged"/><CheckBox x:Name="VideoFade" Content="Video fade in/out" Checked="OptionChanged" Unchecked="OptionChanged"/></WrapPanel>
  <WrapPanel><TextBlock Text="Crop X" VerticalAlignment="Center"/><TextBox x:Name="CropX" Width="55" Text="0" TextChanged="OptionChanged"/><TextBlock Text="Y" VerticalAlignment="Center"/><TextBox x:Name="CropY" Width="55" Text="0" TextChanged="OptionChanged"/><TextBlock Text="W" VerticalAlignment="Center"/><TextBox x:Name="CropW" Width="55" Text="0" TextChanged="OptionChanged"/><TextBlock Text="H" VerticalAlignment="Center"/><TextBox x:Name="CropH" Width="55" Text="0" TextChanged="OptionChanged"/><CheckBox x:Name="Watermark" Content="Corner logo/image (auto-fit)" Checked="OptionChanged" Unchecked="OptionChanged"/><Button Content="Choose overlay" Click="OverlayClick"/><TextBlock x:Name="OverlayName" Width="120" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></WrapPanel>
  <TextBlock Text="EXPORT" FontSize="20" FontWeight="Bold" Margin="0,18,0,3"/><WrapPanel><TextBlock Text="Format" VerticalAlignment="Center"/><ComboBox x:Name="Format" Width="90" SelectionChanged="OptionChanged"><ComboBoxItem Content="mp4"/><ComboBoxItem Content="mov"/><ComboBoxItem Content="mkv"/></ComboBox><TextBlock Text="Preset" VerticalAlignment="Center"/><ComboBox x:Name="Quality" Width="145" SelectionChanged="OptionChanged"><ComboBoxItem Content="High Quality"/><ComboBoxItem Content="Balanced"/><ComboBoxItem Content="Small File"/></ComboBox><CheckBox x:Name="Hardware" Content="NVIDIA GPU encoder (fallback to CPU)" Checked="OptionChanged" Unchecked="OptionChanged"/></WrapPanel>
  <WrapPanel><Button Content="Choose output folder" Click="FolderClick"/><TextBlock x:Name="FolderName" VerticalAlignment="Center" MaxWidth="620" TextTrimming="CharacterEllipsis"/></WrapPanel>
  <TextBlock x:Name="EstimateText" Foreground="#93C5FD" Margin="6,4,0,4"/>
  <CheckBox x:Name="RightsVideo" Content="I have rights to the source visuals and selected overlays" Checked="OptionChanged" Unchecked="OptionChanged"/><CheckBox x:Name="RightsAudio" Content="I own or have licenses for included audio/music/effects (not needed for mute)" Checked="OptionChanged" Unchecked="OptionChanged"/><TextBlock Text="Editing or re-encoding does not remove copyright or guarantee YouTube Content ID clearance." Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,8,0,8"/>
 </StackPanel></ScrollViewer>
</DockPanel></Window>
