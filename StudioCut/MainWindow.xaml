<Window x:Class="StudioCut.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StudioCut — One-Click Video Converter"
        Width="720" Height="650" MinWidth="560" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="#0B1220"
        Foreground="#F1F5F9"
        AllowDrop="True" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.38"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="28,18,28,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="STUDIOCUT" FontSize="27" FontWeight="Bold" Foreground="#7DD3FC"/>
            <TextBlock Text="One video. One click. A fresh, high-quality MP4." FontSize="14" Foreground="#B8C8DD" Margin="0,4,0,0"/>
        </StackPanel>

        <Border x:Name="DropZone" Grid.Row="2" Margin="0,8,0,8"
                Background="#121F30" BorderBrush="#415B77" BorderThickness="2"
                CornerRadius="16" Padding="16" Height="162" AllowDrop="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="10,0,15,0">
                    <TextBlock x:Name="DropTitle" Text="Drop a video here" FontSize="23" FontWeight="SemiBold"
                               Foreground="#F8FAFC" TextWrapping="Wrap"/>
                    <TextBlock Text="or choose a video from your computer" FontSize="14"
                               Foreground="#94A3B8" Margin="0,8,0,16" TextWrapping="Wrap"/>
                    <Button x:Name="ChooseVideoButton" Content="Choose video" Click="ChooseVideoClick"
                            Width="170" HorizontalAlignment="Left" Background="#264C72"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#0B1220" CornerRadius="10" Padding="4">
                    <Grid>
                        <TextBlock x:Name="EmptyPoster" Text="VIDEO" Foreground="#49637E" FontSize="17"
                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="PosterImage" Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,0,0,13">
            <TextBlock x:Name="SelectedVideoText" Text="No video selected" FontSize="16"
                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="#F1F5F9"/>
            <TextBlock x:Name="SelectedDetailsText" Text="Your source file remains unchanged. Video and audio are re-encoded."
                       Foreground="#A9BCD1" Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="ConvertButton" Content="Convert" Width="190"
                    Background="#127A68" FontSize="17" IsEnabled="False" Click="ConvertClick"/>
            <Button x:Name="CancelButton" Content="Cancel" Click="CancelClick"
                    Visibility="Collapsed" Width="105" Background="#475569"/>
        </StackPanel>

        <ProgressBar x:Name="Progress" Grid.Row="5" Height="9" Minimum="0" Maximum="100"
                     Background="#1E293B" Foreground="#34D399" Margin="0,0,0,10"/>
        <TextBlock x:Name="StatusText" Grid.Row="6" Text="Choose or drop a video to begin."
                   TextWrapping="Wrap" Foreground="#C9D8E9" MinHeight="32" Margin="0,0,0,4"/>
        <StackPanel Grid.Row="7" Margin="0,3,0,0">
            <TextBlock x:Name="OutputPathText" TextWrapping="Wrap" Foreground="#91E1C0"
                       FontSize="12" Text="Output: Videos\StudioCut Exports" Margin="0,0,0,8"/>
            <Button x:Name="OpenOutputButton" Content="Open output folder" Width="185"
                    HorizontalAlignment="Left" Visibility="Collapsed" Click="OpenOutputClick"
                    Background="#264C72" Margin="0,0,0,10"/>
            <TextBlock Text="Offline • MP4/H.264 + AAC • No manual settings • Original file unchanged"
                       FontSize="12" Foreground="#8EA4BC" TextWrapping="Wrap"/>
            <TextBlock Text="Only publish content you have permission to use. Re-encoding does not hide AI origin or clear copyright claims."
                       FontSize="12" Foreground="#E3BB6B" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
